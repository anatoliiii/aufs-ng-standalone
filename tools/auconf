#!/usr/bin/env python3
"""Generate config.mk presets for aufs-ng-standalone."""
from __future__ import annotations

import argparse
import copy
import pathlib
from typing import Dict, List, Tuple

CONFIG_SECTION_SENTINEL = "########################################\n"

CONFIG_ORDER: List[Tuple[str, str]] = [
    ("CONFIG_AUFS_BRANCH_MAX_127", "assign"),
    ("CONFIG_AUFS_BRANCH_MAX_511", "assign"),
    ("CONFIG_AUFS_BRANCH_MAX_1023", "assign"),
    ("CONFIG_AUFS_BRANCH_MAX_32767", "comment_bool"),
    ("CONFIG_AUFS_SBILIST", "assign"),
    ("CONFIG_AUFS_HNOTIFY", "assign"),
    ("CONFIG_AUFS_HFSNOTIFY", "assign"),
    ("CONFIG_AUFS_EXPORT", "assign"),
    ("CONFIG_AUFS_XATTR", "assign"),
    ("CONFIG_AUFS_FHSM", "assign"),
    ("CONFIG_AUFS_RDU", "assign"),
    ("CONFIG_AUFS_SHWH", "assign"),
    ("CONFIG_AUFS_BR_RAMFS", "assign"),
    ("CONFIG_AUFS_BR_FUSE", "assign"),
    ("CONFIG_AUFS_BR_HFSPLUS", "assign"),
    ("CONFIG_AUFS_DEBUG", "debug"),
    ("CONFIG_AUFS_DIRREN", "assign"),
    ("CONFIG_AUFS_MAGIC_SYSRQ", "assign"),
    ("CONFIG_AUFS_BDEV_LOOP", "assign"),
    ("CONFIG_AUFS_INO_T_64", "assign"),
    ("CONFIG_AUFS_POLL", "assign"),
]

BASE_RELEASE: Dict[str, str] = {
    "CONFIG_AUFS_BRANCH_MAX_127": "y",
    "CONFIG_AUFS_BRANCH_MAX_511": "",
    "CONFIG_AUFS_BRANCH_MAX_1023": "",
    "CONFIG_AUFS_BRANCH_MAX_32767": "",
    "CONFIG_AUFS_SBILIST": "y",
    "CONFIG_AUFS_HNOTIFY": "",
    "CONFIG_AUFS_HFSNOTIFY": "",
    "CONFIG_AUFS_EXPORT": "",
    "CONFIG_AUFS_XATTR": "",
    "CONFIG_AUFS_FHSM": "",
    "CONFIG_AUFS_RDU": "",
    "CONFIG_AUFS_SHWH": "",
    "CONFIG_AUFS_BR_RAMFS": "",
    "CONFIG_AUFS_BR_FUSE": "",
    "CONFIG_AUFS_BR_HFSPLUS": "",
    "CONFIG_AUFS_DEBUG": "",
    "CONFIG_AUFS_DIRREN": "",
    "CONFIG_AUFS_MAGIC_SYSRQ": "",
    "CONFIG_AUFS_BDEV_LOOP": "",
    "CONFIG_AUFS_INO_T_64": "",
    "CONFIG_AUFS_POLL": "",
}

PRESETS: Dict[str, Dict[str, str]] = {
    "release": {},
    "debug": {
        "CONFIG_AUFS_DEBUG": "y",
        "CONFIG_AUFS_MAGIC_SYSRQ": "y",
        "CONFIG_AUFS_HNOTIFY": "y",
        "CONFIG_AUFS_RDU": "y",
    },
    "max-branches": {
        "CONFIG_AUFS_BRANCH_MAX_127": "",
        "CONFIG_AUFS_BRANCH_MAX_511": "",
        "CONFIG_AUFS_BRANCH_MAX_1023": "",
        "CONFIG_AUFS_BRANCH_MAX_32767": "y",
    },
}

PRESET_DESCRIPTIONS = {
    "release": "Matches upstream defaults targeting production Aya OS builds.",
    "debug": "Turns on deep tracing knobs and relaxed sysrq for kernel debugging.",
    "max-branches": "Enables 32k branch table support for dense layer stacks.",
}


def parse_overrides(values: List[str]) -> Dict[str, str]:
    overrides: Dict[str, str] = {}
    for item in values:
        if "=" not in item:
            raise ValueError(f"override must be NAME=VALUE, got '{item}'")
        key, value = item.split("=", 1)
        key = key.strip()
        if key not in BASE_RELEASE:
            raise ValueError(f"unknown config knob: {key}")
        overrides[key] = value.strip()
    return overrides


def load_tail(template_path: pathlib.Path) -> str:
    data = template_path.read_text()
    try:
        idx = data.index(CONFIG_SECTION_SENTINEL)
    except ValueError as exc:
        raise SystemExit("config.mk template is missing the sentinel") from exc
    return data[idx:]


def normalize_branch_limits(config: Dict[str, str]) -> None:
    # Only allow a single branch limit to be enabled at once.
    branch_keys = [
        "CONFIG_AUFS_BRANCH_MAX_127",
        "CONFIG_AUFS_BRANCH_MAX_511",
        "CONFIG_AUFS_BRANCH_MAX_1023",
        "CONFIG_AUFS_BRANCH_MAX_32767",
    ]
    selected = None
    for key in branch_keys:
        if config.get(key) in {"y", "Y", "1", "true", "True"}:
            selected = key
    for key in branch_keys:
        if key == selected:
            config[key] = "y"
        else:
            config[key] = ""


def normalize_debug(config: Dict[str, str]) -> None:
    if config.get("CONFIG_AUFS_DEBUG", "").lower() in {"y", "yes", "1", "true"}:
        config["CONFIG_AUFS_DEBUG"] = "y"
    else:
        config["CONFIG_AUFS_DEBUG"] = ""


def render_header(config: Dict[str, str]) -> str:
    lines: List[str] = [
        "# SPDX-License-Identifier: GPL-2.0",
        "",
        "# Kconfig",
        "# instead of setting 'n', leave it blank when you disable it.",
        "# this file can be regenerated via tools/auconf",
    ]
    for name, kind in CONFIG_ORDER:
        value = config.get(name, "")
        if kind == "assign":
            lines.append(f"{name} = {value}" if value else f"{name} =")
        elif kind == "comment_bool":
            if value:
                lines.append(f"{name} = {value}")
            else:
                lines.append(f"#{name} =")
        elif kind == "debug":
            default_value = value if value else "n"
            if value:
                lines.append(f"{name} ?= {default_value}")
            else:
                lines.append(f"{name} ?= n")
        else:
            raise RuntimeError(f"unsupported render kind: {kind}")
    lines.append("")
    return "\n".join(lines)


def summarise(config: Dict[str, str], base: Dict[str, str]) -> str:
    rows = []
    for key in CONFIG_ORDER:
        name = key[0]
        base_val = base.get(name, "")
        new_val = config.get(name, "")
        if base_val == new_val:
            continue
        rows.append(f"- {name}: '{base_val or 'off'}' -> '{new_val or 'off'}'")
    if not rows:
        return "(no changes vs release preset)"
    return "\n".join(rows)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--preset",
        action="append",
        choices=sorted(PRESETS.keys()),
        default=["release"],
        help="Apply the named preset (can be repeated).",
    )
    parser.add_argument(
        "--set",
        action="append",
        default=[],
        metavar="NAME=VALUE",
        help="Override individual CONFIG options after presets are applied.",
    )
    parser.add_argument(
        "--output",
        type=pathlib.Path,
        default=pathlib.Path("config.mk"),
        help="Destination file (default: config.mk).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Write the generated config to stdout without touching disk.",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Overwrite an existing config.mk without prompting.",
    )
    parser.add_argument(
        "--show",
        action="store_true",
        help="Print a diff-style summary of toggles versus the release preset.",
    )
    parser.add_argument(
        "--list-presets",
        action="store_true",
        help="List available presets and exit.",
    )
    args = parser.parse_args()

    if args.list_presets:
        for name in sorted(PRESETS):
            print(f"{name}: {PRESET_DESCRIPTIONS.get(name, '')}")
        return

    config = copy.deepcopy(BASE_RELEASE)
    base = copy.deepcopy(BASE_RELEASE)

    for preset_name in args.preset:
        preset_values = PRESETS[preset_name]
        config.update(preset_values)

    overrides = parse_overrides(args.set)
    config.update(overrides)

    normalize_branch_limits(config)
    normalize_debug(config)

    header = render_header(config)
    tail = load_tail(args.output if args.output.exists() else pathlib.Path("config.mk"))

    final = header + tail

    if args.show:
        print(summarise(config, base))

    if args.dry_run:
        print(final, end="")
        return

    if args.output.exists() and not args.force:
        raise SystemExit(f"{args.output} exists. Use --force to overwrite.")

    args.output.write_text(final)


if __name__ == "__main__":
    main()
